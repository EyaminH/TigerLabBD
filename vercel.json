{
  "version": 2,
  "builds": [
    {
      "src": "ctf_platform/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.12" }
    }
  ],
  "buildCommand": "bash vercel_build.sh",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "ctf_platform/wsgi.py"
    }
  ]
}
